      ]
    },
    {
      "en": "She has beautiful eyes.",
      "fr": "Elle a de beaux yeux.",
      "vocab": [
        { "fr": "de beaux", "en": "beautiful (des becomes de before a plural adjective + noun)" },
        { "fr": "œil / yeux", "en": "eye / eyes (irregular plural)" }
      ]
    },
    {
