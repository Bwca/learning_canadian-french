      "fr": "Vous n'avez pas de voiture.",
      "vocab": [
        { "fr": "voiture", "en": "car" }
      ]
    },
    {
      "en": "They (masc.) don't have a dog.",
      "fr": "Ils n'ont pas de chien.",
      "vocab": [
        { "fr": "chien", "en": "dog" }
      ]
    },
    {
      "en": "There isn't any sugar in the tea.",
      "fr": "Il n'y a pas de sucre dans le thé.",
      "vocab": [
        { "fr": "sucre", "en": "sugar" },
        { "fr": "thé", "en": "tea" }
      ]
    },
    {
      "en": "I don't eat fish.",
      "fr": "Je ne mange pas de poisson.",
      "vocab": [
        { "fr": "manger", "en": "to eat" },
