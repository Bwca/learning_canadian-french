{
  "title": "Negation — pas de (dropping du/de la/de l'/des/un/une) (set 10: mixed review)",
  "exercises": [
    {
      "en": "I don't have any bread.",
      "fr": "Je n'ai pas de pain.",
      "vocab": [
        { "fr": "pain", "en": "bread" }
      ]
    },
    {
      "en": "There isn't any snow today.",
      "fr": "Il n'y a pas de neige aujourd'hui.",
      "vocab": [
        { "fr": "neige", "en": "snow" },
        { "fr": "aujourd'hui", "en": "today" }
      ]
    },
    {
      "en": "You (informal) don't eat meat.",
      "fr": "Tu ne manges pas de viande.",
      "vocab": [
        { "fr": "manger", "en": "to eat" },
        { "fr": "viande", "en": "meat" }
      ]
    },
    {
      "en": "We don't like coffee.",
      "fr": "Nous n'aimons pas le café.",
      "vocab": [
        { "fr": "aimer", "en": "to like / to love" },
        { "fr": "café", "en": "coffee" }
      ]
    },
    {
      "en": "She doesn't have a key.",
      "fr": "Elle n'a pas de clé.",
      "vocab": [
        { "fr": "clé", "en": "key" }
      ]
    },
    {
      "en": "There isn't a chair in the bedroom.",
