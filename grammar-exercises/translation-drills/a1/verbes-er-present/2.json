      "vocab": [
        { "fr": "danser", "en": "to dance" },
        { "fr": "fête", "en": "party" }
      ]
    },
    {
      "en": "We love winter.",
      "fr": "Nous aimons l'hiver.",
      "vocab": [
        { "fr": "aimer", "en": "to like / to love" },
