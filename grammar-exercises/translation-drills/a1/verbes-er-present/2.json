      "vocab": [
        { "fr": "regarder", "en": "to watch" },
        { "fr": "partie", "en": "game (match)" }
      ]
    },
    {
      "en": "We study French.",
      "fr": "Nous étudions le français.",
      "vocab": [
        { "fr": "étudier", "en": "to study" }
      ]
    },
    {
      "en": "They (fem.) dance at the party.",
